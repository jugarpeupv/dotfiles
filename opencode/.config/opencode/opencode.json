{
  "$schema": "https://opencode.ai/config.json",
  "agents": {},
  "compaction": {
    "auto": true
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "codegraph": {
        "type": "local",
        "disabled": true,
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ]
      },
      "engram": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/engram",
          "mcp",
          "--tools=agent"
        ],
        "disabled": true
      },
      "github-server": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:GH_ACTIONS_PAT}"
        }
      },
      "nx": {
        "type": "local",
        "command": [
          "npx",
          "nx-mcp@latest"
        ],
        "environment": {
          "npm_config_registry": "https://registry.npmjs.org"
        },
        "disabled": true,
      },
      "tavily": {
        "type": "local",
        "disabled": true,
        "command": [
          "npx",
          "-y",
          "tavily-mcp"
        ],
        "environment": {
          "TAVILY_API_KEY": "{env:TAVILY_API_KEY}",
          "npm_config_registry": "https://registry.npmjs.org"
        }
      }
    },
  },
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "**/dotfiles/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "**/.local/share/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "**/.config/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pass *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "op *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "bw *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "mv *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "security *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "**/*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.aws/credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.config/gh/hosts.yml",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.credentials/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/Library/Keychains/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/credentials.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/secrets/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    }
  ],
  "providers": {
    "lmstudio": {
      "name": "LM Studio (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (local)"
        },
        "google/gemma-3-4b": {
          "name": "Gemma 3 4B (local)"
        },
        "qwen/qwen3-4b": {
          "name": "Qwen3 4B (local)"
        }
      }
    }
  },
  "share": "disabled",
  "snapshots": true,
  "update": "auto"
}
