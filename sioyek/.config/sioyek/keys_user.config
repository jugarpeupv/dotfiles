# To see default keybindings
# /Applications/sioyek.app/Contents/MacOS/keys.config

# scroll one line with u / d
screen_up u
screen_down d
screen_up <C-u>
screen_down <C-d>
zoom_in K
zoom_out J

# F8 is hijacked by the Help > Donate menu shortcut on macOS (sioyek issue #1264), use F3 as fallback
# toggle_dark_mode <f3>
toggle_dark_mode I

# copy selected text with Cmd-C (D- = Command/meta on macOS)
copy <D-c>

# vim-style navigation inside menus/pickers (command palette, TOC,
# bookmarks, ...). The [m] prefix makes a binding apply only when a
# menu is focused.
[m]control_menu(down) <C-j>
[m]control_menu(up) <C-k>

