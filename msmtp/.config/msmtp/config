defaults
auth           login
protocol        smtp
tls            off
tls_starttls   off
tls_certcheck  off
logfile        ~/msmtp.log


account        izertis
host           localhost
port           1025

eval pass izertis_login | awk -F: '/^username:/{print "user " $2}' | xargs
eval pass izertis_login | awk -F: '/^username:/{print "from " $2}' | xargs
passwordeval "pass izertis_login | head -1"



account        gmail
host           smtp.gmail.com
port           587
auth           oauthbearer
tls            on
tls_starttls   on
eval echo user $(pass gmail_personal_account)
eval echo from $(pass gmail_personal_account)
passwordeval   mutt_oauth2.py $GMAIL_OAUTH_TOKENS_FILE --provider google --format token


account default : izertis
