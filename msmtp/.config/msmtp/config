defaults
auth           login
protocol        smtp
tls            off
tls_starttls   off
tls_certcheck  off
logfile        ~/.config/msmtp/msmtp.log


account        izertis
host           localhost
port           1025
eval echo user $(pass izertis_username)
eval echo from $(pass izertis_username)
passwordeval   pass izertis_password



account        gmail
host           smtp.gmail.com
port           587
auth           oauthbearer
tls            on
tls_starttls   on
eval echo user $(pass gmail_personal_account)
eval echo from $(pass gmail_personal_account)
passwordeval   mutt_oauth2.py ~/.config/personal.gmail.com.tokens --provider google --format token


account default : izertis
